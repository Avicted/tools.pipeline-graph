# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

# Headless Chromium + Node for scripts/screenshots.mjs. The screenshots are
# taken in this image so they look the same on every machine: same browser,
# same fonts, same emoji.
#
# Build + run:  make screenshots

FROM node:24-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315

# Debian removes superseded chromium builds from its mirrors, so pinning the
# package version would break the build after the next security update.
# hadolint ignore=DL3008
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-inter fonts-dejavu-core fonts-noto-color-emoji \
 && rm -rf /var/lib/apt/lists/*

ENV CHROME=chromium CHROME_NO_SANDBOX=1
